# Copy to .env.remote-demo on JSZX-AI-03. Do not copy production .env or commit it.
# The reverse proxy/VPN must restrict this hostname to company network users.
APP_BASE_URL=https://ai-token-dashboard-dev.internal
SESSION_SECRET=replace-with-an-independent-random-secret-at-least-32-characters
REMOTE_DEMO_BIND_ADDRESS=10.68.13.188
SESSION_COOKIE_NAME=ai_token_dashboard_remote_demo_session

# Authenticate through SSO or an authenticated internal reverse proxy.
DEV_LOGIN_ENABLED=false
AUTH_ENABLED=false
PASSWORD_LOGIN_ENABLED=false
PUBLIC_SIGNUP_ENABLED=false
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SERVER_METADATA_URL=

# The PostgreSQL role in this URL must be a dedicated SELECT-only role.
USAGE_DATABASE_URL=postgresql://ai_usage_demo_reader:replace-me@usage-db:5432/ai_usage
USAGE_SYNC_ENABLED=true
USAGE_SYNC_ROLE=reader
USAGE_REALTIME_ENABLED=false
USAGE_SNAPSHOT_BACKEND_IDS=primary,her
USAGE_DB_POOL_MIN_SIZE=1
USAGE_DB_POOL_MAX_SIZE=3

REMOTE_DEMO_READ_ONLY=true
ORGANIZATION_MODE=disabled
ORGANIZATION_DEMO_ENABLED=false
BILLING_ENABLED=false
ADMIN_OBSERVABILITY_DASHBOARDS_ENABLED=false
DEBUG_MAPPING_ENABLED=false
DEBUG_OIDC_CLAIMS=false

# Must stay empty: the demo server never contacts upstream management APIs.
LITELLM_BASE_URL=
LITELLM_ADMIN_KEY=
HER_LITELLM_BASE_URL=
HER_LITELLM_ADMIN_KEY=
