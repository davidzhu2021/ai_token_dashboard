LITELLM_BASE_URL=https://cc.auto-link.com.cn/pro
LITELLM_ADMIN_KEY=<backend-admin-key>

# Optional: Her chatbot usage source. Leave empty to disable.
HER_LITELLM_BASE_URL=https://litellm.carher.net
HER_LITELLM_ADMIN_KEY=<her-backend-admin-key>
HER_SOURCE_LABEL=Her
HER_ACCOUNT_INDEX_CACHE_TTL_SECONDS=1800
HER_KEY_LIST_MAX_PAGES=20

APP_BASE_URL=https://myai.carher.net
SESSION_SECRET=replace-with-a-random-long-string

# Optional email/password authentication. Keep all entry points disabled until
# SMTP, Turnstile, persistent storage, and the email-domain allowlist are ready.
AUTH_ENABLED=false
PASSWORD_LOGIN_ENABLED=false
PUBLIC_SIGNUP_ENABLED=false
EMAIL_VERIFICATION_REQUIRED=true
AUTH_ALLOWED_EMAIL_DOMAINS=auto-link.com.cn,gmail.com,qq.com,163.com
AUTH_DATABASE_PATH=.data/auth.sqlite3
# Newly registered users are provisioned as view-only and remain inactive
# until access is granted separately. Never use an admin role here.
AUTH_DEFAULT_UPSTREAM_ROLE=internal_user_viewer
AUTH_SESSION_TTL_SECONDS=1209600
AUTH_VERIFICATION_TTL_SECONDS=600
AUTH_PASSWORD_RESET_TTL_SECONDS=1800
AUTH_PROVISIONING_RETRY_SECONDS=30
AUTH_ENTITLEMENT_CACHE_TTL_SECONDS=30

# Authentication email delivery. Two supported shapes:
#
# 1) Self-hosted MTA (the `mail-relay` compose service). Point SMTP_HOST at the
#    service name and set SMTP_LOCAL_RELAY=true. The hop stays on the private
#    container network, so it needs no credentials and no TLS; the MTA itself
#    negotiates STARTTLS with each recipient and signs outbound mail with DKIM.
#    Requires outbound port 25 plus published SPF/DKIM/DMARC and a PTR record.
#    The sender domain is a subdomain of the site domain carher.net: SPF is
#    published per name and is NOT inherited, so a stricter policy on the apex
#    does not apply here and does not need to be touched. Keeping the sender on
#    the same apex as the site also stops recipients reading it as a lookalike.
#    Note that 163.com blocks inbound port 25 from this host, so mail to
#    @163.com cannot be delivered by this relay; QQ and Gmail are reachable.
SMTP_LOCAL_RELAY=false
SMTP_HOST=mail-relay
SMTP_PORT=25
SMTP_FROM=no-reply@notify.carher.net
MAIL_RELAY_SENDER_DOMAINS=notify.carher.net
# HELO host name. Keep it different from the sender domain above, and point its
# A record plus the sending IP's PTR record at each other.
MAIL_RELAY_HELO_NAME=mail.notify.carher.net
MAIL_RELAY_DKIM_SELECTOR=mail
#
# 2) Third-party transactional provider. Leave SMTP_LOCAL_RELAY=false and set an
#    authenticated, encrypted transport (exactly one of SSL or STARTTLS).
SMTP_USERNAME=<smtp-username>
SMTP_PASSWORD=<smtp-password>
SMTP_SSL=false
SMTP_STARTTLS=true

# Bot protection for internet-facing password authentication.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Escape hatch that allows public signup/login over HTTPS without Turnstile.
# Only per-email and per-IP rate limits then stand between scripted clients and
# the outbound mail quota. Prefer configuring Turnstile and keeping this false.
AUTH_ALLOW_NO_BOT_PROTECTION=false

# Comma-separated direct reverse-proxy IPs/CIDRs allowed to supply X-Forwarded-For.
# Leave empty when connecting directly; never use 0.0.0.0/0 or ::/0.
AUTH_TRUSTED_PROXY_IPS=

# Casdoor + Feishu SSO.
OIDC_ISSUER_URL=http://10.68.13.198:30882
OIDC_CLIENT_ID=ai-token-dashboard-client-id
OIDC_CLIENT_SECRET=ai-token-dashboard-client-secret
OIDC_CASDOOR_APPLICATION_ID=admin/ai-token-dashboard
OIDC_APPLICATION_NAME=ai-token-dashboard
OIDC_DIRECT_PROVIDER=lark-provider
OIDC_DIRECT_METHOD=signup
OIDC_SKIP_CASDOOR_PAGE=true
OIDC_PROVIDER_LOGIN_HOST=accounts.feishu.cn
OAUTH_PROVIDER_NAME=飞书扫码登录
ALLOWED_EMAIL_DOMAIN=auto-link.com.cn
ADMIN_EMAILS=zhuyida@auto-link.com.cn,leader@auto-link.com.cn

FEISHU_DIRECT_LOGIN_ENABLED=false
FEISHU_APP_ID=cli-your-feishu-app-id
FEISHU_REDIRECT_URI=http://10.68.13.198:30882/callback

# Local development only. Keep false in production.
DEV_LOGIN_ENABLED=false
DEBUG_MAPPING_ENABLED=false
DEBUG_OIDC_CLAIMS=false
# Customer organization runtime. Production should use `real`; `demo` is only
# for local development and tests, and `disabled` hides the capability.
ORGANIZATION_MODE=disabled
# Required when ORGANIZATION_MODE=real. Generate a stable random value and keep
# it secret: invitation links are signed from this value and only their hashes
# are persisted in PostgreSQL.
ORGANIZATION_INVITATION_SECRET=
ORGANIZATION_OUTBOX_INTERVAL_SECONDS=30
ORGANIZATION_OUTBOX_MAX_ATTEMPTS=8
ORGANIZATION_CAPABILITY_RECHECK_SECONDS=60
# Optional server-owned pilot adoption configuration. Values are comma-separated
# exact identifiers/aliases used only by the platform preview/apply endpoints;
# never expose them in browser HTML or JavaScript.
ORGANIZATION_ADOPTION_ORGANIZATION_CANDIDATES=
ORGANIZATION_ADOPTION_TEAM_CANDIDATES=
ORGANIZATION_ADOPTION_KEY_ALIASES=
ORGANIZATION_ADOPTION_BACKEND_ID=primary
# Upstream companies that belong to the seller rather than to a customer.
# Comma-separated exact ids; they are hidden from the pending-adoption list.
ORGANIZATION_INTERNAL_UPSTREAM_IDS=
ORGANIZATION_PENDING_ADOPTION_CACHE_TTL_SECONDS=300
# Legacy compatibility only. Prefer ORGANIZATION_MODE for new deployments.
ORGANIZATION_DEMO_ENABLED=false
USAGE_LOG_MAX_PAGES=20
USER_MAPPING_CACHE_TTL_SECONDS=1800
PERSONAL_USAGE_CACHE_TTL_SECONDS=300
ADMIN_USAGE_CACHE_TTL_SECONDS=300
DEPARTMENT_USAGE_CACHE_TTL_SECONDS=300
TEAM_AUTH_CACHE_TTL_SECONDS=300
TEAM_USAGE_CACHE_TTL_SECONDS=300
TEAM_DETAILS_CACHE_TTL_SECONDS=300
TEAM_MEMBER_FALLBACK_CONCURRENCY=4
KEY_LIST_CACHE_TTL_SECONDS=300
# Base64url-encoded 32-byte key. Generate once and keep it stable; never commit it.
KEY_VAULT_MASTER_KEY=<base64url-encoded-32-byte-key>
KEY_VAULT_DATABASE_PATH=.data/key-vault.sqlite3
MODEL_CACHE_TTL_SECONDS=1800
MODEL_USAGE_CACHE_TTL_SECONDS=300
LITELLM_MAX_CONCURRENCY=4
LITELLM_SLOW_REQUEST_MS=800
PERSONAL_USAGE_LOG_FALLBACK_ENABLED=false
ADMIN_USAGE_LOG_MAX_PAGES=30
ADMIN_USAGE_PAGE_SIZE=100
USAGE_TIMEZONE_OFFSET_MINUTES=-480

# Optional persistent aggregated usage snapshots. Enable in production after PostgreSQL is ready.
USAGE_DB_PASSWORD=replace-with-a-random-database-password
USAGE_DATABASE_URL=postgresql://ai_dashboard:replace-with-a-random-database-password@usage-db:5432/ai_usage
USAGE_SYNC_ENABLED=false
USAGE_REDIS_URL=redis://usage-redis:6379/0
USAGE_REALTIME_ENABLED=true
USAGE_REALTIME_POLL_SECONDS=10
USAGE_REALTIME_OVERLAP_SECONDS=60
# 启动恢复时先接上最近实时窗口，较早缺口按独立 checkpoint 分批补偿。
USAGE_REALTIME_LIVE_WINDOW_SECONDS=60
USAGE_REALTIME_BACKFILL_PAGES_PER_CYCLE=5
USAGE_REALTIME_STALE_SECONDS=30
USAGE_REALTIME_EVENT_TTL_SECONDS=259200
USAGE_REALTIME_LOCK_TTL_SECONDS=300
USAGE_REALTIME_LOCK_RENEW_SECONDS=100
USAGE_REALTIME_RECONCILE_INTERVAL_SECONDS=300
# reader = Web 只读已提交快照（生产 Web），worker = 独立同步进程，combined = 本地单进程开发。
USAGE_SYNC_ROLE=combined
USAGE_SYNC_INTERVAL_SECONDS=1800
USAGE_SYNC_CALIBRATION_INTERVAL_SECONDS=21600
USAGE_INITIAL_BACKFILL_DAYS=90
USAGE_SYNC_RECENT_DAYS=2
USAGE_SYNC_CALIBRATION_DAYS=3
# 仅 combined 模式的进程内同步循环使用。
USAGE_SYNC_LOOKBACK_DAYS=3
USAGE_SYNC_STARTUP_MAX_AGE_SECONDS=1800
USAGE_LIVE_REFRESH_MAX_AGE_SECONDS=1800
USAGE_SYNC_HEARTBEAT_INTERVAL_SECONDS=30
USAGE_SYNC_HEARTBEAT_MAX_AGE_SECONDS=120
USAGE_SYNC_SUCCESS_MAX_AGE_SECONDS=3600
USAGE_SYNC_USER_CONCURRENCY=2
USAGE_WEB_DB_POOL_MIN_SIZE=1
USAGE_WEB_DB_POOL_MAX_SIZE=5
USAGE_WORKER_DB_POOL_MIN_SIZE=1
USAGE_WORKER_DB_POOL_MAX_SIZE=3

# 增量同步按本地时区日界归日：上游按天聚合的接口使用 UTC 日期，会把北京时间
# 00:00-08:00 的用量算进前一天。开启后同步改为扫描原始调用日志自行归日。
# 扫描单日约 3 分钟（全局约 8 万条日志、上游每页上限 100 条），因此仅对不超过
# USAGE_SYNC_LOG_MAX_WINDOW_DAYS 的窗口启用；初始回填等长窗口仍走按天聚合接口。
# 扫描失败或被页数上限截断时自动退回原路径，不会写入残缺快照。
USAGE_SYNC_LOG_TIMEZONE_ENABLED=true
USAGE_SYNC_LOG_MAX_WINDOW_DAYS=3
USAGE_SYNC_LOG_CONCURRENCY=4
USAGE_SYNC_LOG_PAGE_SIZE=100
USAGE_SYNC_LOG_MAX_PAGES=5000

# 平台管理员稳定性与费用控制看板。
ADMIN_OBSERVABILITY_DASHBOARDS_ENABLED=false
# 治理看板使用 60 秒快照优先；过期快照会立即返回并在后台单飞刷新。
OBSERVABILITY_CACHE_FRESH_SECONDS=300
OBSERVABILITY_CACHE_STALE_MAX_SECONDS=86400
OBSERVABILITY_COLD_QUERY_BUDGET_MS=1500
OBSERVABILITY_REFRESH_TIMEOUT_SECONDS=30
# 费用日汇总按小窗口渐进回填，避免启动时扫描全部请求明细。
COST_AGGREGATE_BACKFILL_DAYS_PER_BATCH=7
STABILITY_SYNC_INTERVAL_SECONDS=900
STABILITY_SYNC_WINDOW_DAYS=7
STABILITY_SYNC_PAGE_SIZE=100
STABILITY_SYNC_MAX_PAGES=5000
STABILITY_SYNC_CONCURRENCY=4
STABILITY_SYNC_PAGE_RETRIES=3
USAGE_SYNC_LOG_PAGE_RETRIES=2
USAGE_SYNC_LOG_BATCH_PAGES=50
STABILITY_FAILURE_STABLE_THRESHOLD=0.01
STABILITY_FAILURE_OBSERVE_THRESHOLD=0.03
STABILITY_TTFT_STABLE_MS=2000
STABILITY_TTFT_OBSERVE_MS=4000
# TTFT 覆盖不足时仅展示观测结果，不参与绿色“稳定”判定。
STABILITY_TTFT_MIN_COVERAGE=0.8
STABILITY_TTFT_MIN_SAMPLES=30
# 上游尝试事件采集。生产使用独立随机密钥，并只提供给部署侧脱敏回调。
# 密钥与 LiteLLM Proxy 侧推送方（integrations/litellm/observability_attempt_pusher.py）
# 的 OBSERVABILITY_INGEST_HMAC_SECRET 保持一致；未配置时采集接口返回 404，
# 稳定性看板的「兜底成功率」因缺少尝试事件保持不可用。部署步骤见
# docs/observability-attempt-events.md；自检脚本见 scripts/observability_ingest_check.py。
OBSERVABILITY_INGEST_HMAC_SECRET=
OBSERVABILITY_INGEST_MAX_BODY_BYTES=262144
OBSERVABILITY_INGEST_MAX_SKEW_SECONDS=300
COST_DEFAULT_MONTHLY_BUDGET_USD=60000
COST_DEFAULT_DAILY_TARGET_USD=2000
COST_DEFAULT_CNY_PER_USD=7.3

# 充值中心。开启后注册用户可自助充值额度，未开启时相关接口返回 404、前端不显示入口。
# 账本与用量快照同库不同表，因此需要先配好 USAGE_DATABASE_URL。
BILLING_ENABLED=false
# 人民币与 1 美元额度的兑换比例：7.3 表示 7.3 元充 1 美元额度。
BILLING_EXCHANGE_RATE=7.3
BILLING_MIN_TOPUP_USD=1
BILLING_MAX_TOPUP_USD=10000
# 充值页面的额度快选档位（美元），逗号分隔。
BILLING_TOPUP_OPTIONS=10,50,100,500
# 充值后同步抬高访问密钥的每日额度上限，仅升不降；0 表示不调整密钥额度。
BILLING_KEY_DAILY_BUDGET_CAP=100
# 兑换码哈希加盐。生产必须配置随机值，否则兑换码只做无盐哈希，易受彩虹表攻击。
# 兑换码只在管理端生成与发放，用户充值页面不显示兑换入口。
BILLING_REDEMPTION_SECRET=
# 首次充值成功后自动授予的模型，逗号分隔。留空则仍需管理员单独开通模型权限。
# 已被管理员单独开通过模型的账号不会被这里的默认集覆盖。
TOPUP_DEFAULT_MODELS=

# 在线支付（易支付协议）。四项缺一即视为未配置，前端在线充值卡片自动隐藏。
EPAY_ENABLED=false
# 支付网关站点根地址，不要带 /submit.php。
EPAY_GATEWAY_URL=
EPAY_PARTNER_ID=
EPAY_KEY=
# 公网可达的本站地址，用于拼接免登录回调 /api/pay/epay/notify；留空则回退 APP_BASE_URL。
# 回调不校验调用者身份，安全性依赖签名校验、订单号状态机与金额比对三道校验。
EPAY_NOTIFY_BASE_URL=

# 收款码转账（人工确认到账）。用于尚未接入商户支付时先跑通充值流程。
# 重要：个人收款码没有支付回调，平台收不到到账通知，因此额度不会自动入账——
# 用户扫码付款后提交付款说明，必须由管理员在"待确认到账"里核对收款流水后确认。
# 该模式属于人工对账，仅适合小规模内部试运行；正式对外收款请改用商户号（EPAY_*）。
MANUAL_PAY_ENABLED=false
# 收款码图片地址，可用外链 https:// 或站内路径 /assets/pay/alipay.png。
# 两项都留空即视为未配置，前端不显示该支付方式。
MANUAL_PAY_ALIPAY_QR=
MANUAL_PAY_WXPAY_QR=
# 付款页提示文案，引导用户在备注里写订单号，便于人工核对。
MANUAL_PAY_NOTICE=请按订单金额扫码付款，并在付款备注里填写订单号，便于快速核对。
# 对外承诺的人工确认时长（分钟），仅用于前端文案。
MANUAL_PAY_REVIEW_MINUTES=30
# 遇到问题时的联系方式，会显示在付款页上；留空则不显示。
MANUAL_PAY_CONTACT=
